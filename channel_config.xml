        <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
          <sequenceNumber>0</sequenceNumber>
          <enabled>true</enabled>
          <script>// 1. Ingest raw HL7 message data fields using Mirth segment mapping notation
var patientId = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();
var lastName  = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;].toString();
var firstName = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;].toString();
var birthDate = msg[&apos;PID&apos;][&apos;PID.7&apos;][&apos;PID.7.1&apos;].toString(); // Format: YYYYMMDD
var genderCode = msg[&apos;PID&apos;][&apos;PID.8&apos;][&apos;PID.8.1&apos;].toString(); // Format: M or F

// 2. Standardize clinical date format from HL7 (YYYYMMDD) to standard FHIR format (YYYY-MM-DD)
var fhirBirthDate = birthDate.substring(0,4) + &quot;-&quot; + birthDate.substring(4,6) + &quot;-&quot; + birthDate.substring(6,8);

// 3. Map standard administrative gender codes
var fhirGender = &quot;unknown&quot;;
if (genderCode === &quot;M&quot;) { fhirGender = &quot;male&quot;; }
else if (genderCode === &quot;F&quot;) { fhirGender = &quot;female&quot;; }

// 4. Construct a completely valid FHIR R4 Patient JSON object structure
var fhirPatient = {
    &quot;resourceType&quot;: &quot;Patient&quot;,
    &quot;id&quot;: patientId,
    &quot;identifier&quot;: [{
        &quot;use&quot;: &quot;official&quot;,
        &quot;type&quot;: {
            &quot;coding&quot;: [{
                &quot;system&quot;: &quot;http://hl7.org&quot;,
                &quot;code&quot;: &quot;MR&quot;
            }]
        },
        &quot;system&quot;: &quot;http://hospital.org&quot;,
        &quot;value&quot;: patientId
    }],
    &quot;name&quot;: [{
        &quot;use&quot;: &quot;official&quot;,
        &quot;family&quot;: lastName,
        &quot;given&quot;: [firstName]
    }],
    &quot;gender&quot;: fhirGender,
    &quot;birthDate&quot;: fhirBirthDate
};

// 5. Convert our clean JSON object into a raw string format and store it inside an export variable
channelMap.put(&apos;fhir_json_payload&apos;, JSON.stringify(fhirPatient));</script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
      </elements>
